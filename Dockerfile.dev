FROM node:20-alpine

RUN apk add --no-cache libc6-compat openssl curl tectonic

WORKDIR /app

# Install dependencies first for better caching
COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npm install

# Don't copy all source files here, as they will be mounted via volumes in docker-compose
# We just need to generate the Prisma client during image build
RUN npx prisma generate

# Pre-warm the tectonic LaTeX package cache during image build.
# This downloads common packages (amsmath, fontenc, babel, geometry, etc.) once,
# so first user compilation is fast instead of timing out on downloads.
RUN mkdir -p /tmp/tectonic-cache /tmp/latex-warmup && \
    printf '\\documentclass{article}\n\\usepackage[utf8]{inputenc}\n\\usepackage[T1]{fontenc}\n\\usepackage[polish]{babel}\n\\usepackage{amsmath}\n\\usepackage{amssymb}\n\\usepackage{geometry}\n\\geometry{a4paper,margin=2.5cm}\n\\begin{document}\nWarmup\n\\end{document}\n' \
      > /tmp/latex-warmup/warmup.tex && \
    XDG_CACHE_HOME=/tmp/tectonic-cache tectonic --untrusted --outdir /tmp/latex-warmup /tmp/latex-warmup/warmup.tex || true && \
    rm -rf /tmp/latex-warmup


# Expose port and start development server
EXPOSE 3000
# Re-generate Prisma client on every start to pick up schema changes without image rebuild
CMD sh -c "npx prisma generate && rm -rf .next && npm run dev"
